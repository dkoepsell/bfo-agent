      <owl:someValuesFrom rdf:resource="#TaskPerformance"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expert knowledge of data protection law and practices</rdfs:label>
  <obo:IAO_0000115 xml:lang="en">A Disposition that inheres in a person and consists of expert knowledge of data protection law and practices.</obo:IAO_0000115>
  <meta:sourceSpan>a person with expert knowledge of data protection law and practices</meta:sourceSpan>
</owl:Class>

