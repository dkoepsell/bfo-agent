  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000197"/>
      <owl:someValuesFrom rdf:resource="#NaturalPerson"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
      <owl:someValuesFrom rdf:resource="#TaskPerformance"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data protection officer</rdfs:label>
  <obo:IAO_0000115 xml:lang="en">A Role that inheres in a person who has expert knowledge of data protection law and practices.</obo:IAO_0000115>
  <meta:sourceSpan>A data protection officer is a person with expert knowledge of data protection law and practices.</meta:sourceSpan>
</owl:Class>

<owl:Class rdf:about="#Expertise">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
  <rdfs:subClassOf>
