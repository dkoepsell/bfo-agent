ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
BFO_PATH=ontology/bfo.owl
WORKING_PATH=ontology/working.owl
SEED_PATH=ontology/seed/legal_seed.ttl
SESSIONS_DIR=sessions
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
ENABLE_GIT_COMMITS=true
# Extractor model: use Haiku for ~5x cost reduction on extraction
# (extraction is recall-and-format; Sonnet quality not needed)
ANTHROPIC_EXTRACTOR_MODEL=claude-haiku-4-5-20251001

# ----- Coherence gate (in-loop BFO conformance) -----
# Run the gate at all. When false, the loop reverts to consistency-only.
ENABLE_COHERENCE_GATE=true
# Reaction on a clash: reject_resample | repair | reground
GATE_POLICY=reject_resample
# Run the reasoner tier inside the gate (lint tier always runs)
GATE_RUN_REASONER=true
# Max resample/reground attempts before flagging for review
GATE_MAX_ATTEMPTS=2
# Add inheres_in / realized_in constraints to committed dependent-continuant classes
ENABLE_SCAFFOLDING=true

# ----- Construction linter (bfo-agent-spec.md PC-1..PC-6) -----
# Reject privation primitives (AbsenceOf*), relation-baked names (XWithY,
# XRelation), untyped entities, invented predicates, and continuant/occurrent
# conflations before they reach the lint/reasoner tiers. This is what stops the
# runaway-flat-class / no-properties failure mode.
ENABLE_CONSTRUCTION_LINTER=true
# Strict closed-vocabulary mode (PC-4): forbid ALL new classes (spec
# case-fragment mode). OFF by default; the workbench builds domain classes on BFO.
STRICT_CLOSED_VOCAB=false
# Class-count budget (FR-7): soft warning when a single proposal mints more than
# N new classes (0 disables). Encourages individuals + property assertions.
CLASS_BUDGET_PER_PROPOSAL=5
# Soft warning once the working ontology exceeds N total classes (0 disables).
CLASS_BUDGET_WARN_TOTAL=0

# ----- Accounts / managed jobs / BYOK (Phase 1) -----
# Flask session signing key. REQUIRED in production (a strong random value).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
# Fernet key to encrypt users' BYOK Anthropic keys at rest. REQUIRED for BYOK.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_ENCRYPTION_KEY=
# SQLite DB for users/jobs/usage (relative to repo root unless absolute)
DB_PATH=data/app.db
# Free-tier limits (free jobs run on the owner key)
FREE_CHAR_LIMIT=20000
FREE_JOB_QUOTA=1
# Hard owner-key token ceiling per free job (0 disables)
FREE_JOB_TOKEN_CAP=200000
