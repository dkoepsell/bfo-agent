    <cfr:chunkId>404.989</cfr:chunkId>
    <cfr:sourceQuote>(a) We will find that there is good cause to reopen a determination or decision if— (1) New and material evidence is furnished; (2) A clerical error in the computation or recomputation of ben</cfr:sourceQuote>
    <cfr:extractionConfidence>high</cfr:extractionConfidence>
    <cfr:approved rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cfr:approved>
    <cfr:reviewNote>hand-authored chain scaffold; anchored on 'good cause' in 404.989</cfr:reviewNote>
    <skos:editorialNote>Phase 4 scaffold term</skos:editorialNote>
  </owl:Class>
