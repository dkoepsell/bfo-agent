  <obo:RO_0000052 rdf:resource="#Thief"/>
  <work3:type rdf:resource="#KnowledgeOfSelfQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ThiefLackOfKnowledgeOfSelf</rdfs:label>
</owl:NamedIndividual>

