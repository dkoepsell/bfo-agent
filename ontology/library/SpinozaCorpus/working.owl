  <rdf:type rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OtherProblemSubjectMatter</rdfs:label>
</owl:NamedIndividual>

