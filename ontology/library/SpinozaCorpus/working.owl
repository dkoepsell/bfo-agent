  <rdf:type rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
  <work3:type rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
  <obo:RO_0000057 rdf:resource="#NecessityOfThingsSubjectMatter"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UnderstandingNecessityOfThings</rdfs:label>
