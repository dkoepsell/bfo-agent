  <work3:type rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
  <obo:RO_0000057 rdf:resource="#OtherProblemSubjectMatter"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UnderstandingOtherProblems</rdfs:label>
