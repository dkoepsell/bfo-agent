@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#
# bfo_core.ttl
#
# Pure-BFO class hierarchy with the standard disjointness axioms.
# Use this as the domain seed for any new ontology built through
# BFO-Agent. It contains no domain-specific vocabulary and ensures
# that the proposer extends a properly-grounded BFO foundation.
#
# This file replaces the legal-specific seed used in SOoL with a
# domain-neutral version suitable for any philosophical, legal,
# scientific, or conceptual ontology.
#
# Disjointness axioms enforce the philosophical commitments of BFO:
# nothing is both continuant and occurrent, nothing is both material
# and immaterial, etc. These are what give the consistency check
# its teeth.
#

# ---------------------------------------------------------------------------
# Top of the hierarchy
# ---------------------------------------------------------------------------

obo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en ;
    rdfs:comment "An entity is anything that exists or has existed or will exist." .

# ---------------------------------------------------------------------------
# Continuant / Occurrent split
# ---------------------------------------------------------------------------

obo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:comment "An entity that persists, endures, or continues to exist through time while maintaining its identity." ;
    rdfs:subClassOf obo:BFO_0000001 .

obo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    rdfs:comment "An entity that has temporal parts and that happens, unfolds, or develops through time." ;
    rdfs:subClassOf obo:BFO_0000001 ;
    owl:disjointWith obo:BFO_0000002 .

# ---------------------------------------------------------------------------
# Continuant subclasses
# ---------------------------------------------------------------------------

obo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:comment "A continuant that is a bearer of qualities and other specifically dependent continuants, but is not itself dependent on any other continuant." ;
    rdfs:subClassOf obo:BFO_0000002 .

obo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    rdfs:comment "A continuant that depends specifically on some independent continuant for its existence (e.g., a quality of a particular bearer)." ;
    rdfs:subClassOf obo:BFO_0000002 .

obo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:comment "A continuant that depends on some bearer or other for its existence, but not on any specific bearer (e.g., the content of a text, which can be realized in many copies)." ;
    rdfs:subClassOf obo:BFO_0000002 .

# Disjointness among the three top continuant categories
[ a owl:AllDisjointClasses ;
  owl:members ( obo:BFO_0000004 obo:BFO_0000020 obo:BFO_0000031 ) ] .

# ---------------------------------------------------------------------------
# Independent continuant subclasses
# ---------------------------------------------------------------------------

obo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:comment "An independent continuant that has some portion of matter as part." ;
    rdfs:subClassOf obo:BFO_0000004 .

obo:BFO_0000141 a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    rdfs:comment "An independent continuant that has no material entity as part." ;
    rdfs:subClassOf obo:BFO_0000004 ;
    owl:disjointWith obo:BFO_0000040 .

obo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:comment "A material entity that has discrete boundaries and consists of a single causally unified whole." ;
    rdfs:subClassOf obo:BFO_0000040 .

obo:BFO_0000027 a owl:Class ;
    rdfs:label "object aggregate"@en ;
    rdfs:comment "A material entity that consists of a plurality of objects." ;
    rdfs:subClassOf obo:BFO_0000040 .

obo:BFO_0000024 a owl:Class ;
    rdfs:label "fiat object part"@en ;
    rdfs:comment "A material entity that is a part of an object delineated by a fiat surface (e.g., the northern hemisphere)." ;
    rdfs:subClassOf obo:BFO_0000040 .

obo:BFO_0000029 a owl:Class ;
    rdfs:label "site"@en ;
    rdfs:comment "An immaterial entity that is a region of three-dimensional space, bounded partly or wholly by material entities." ;
    rdfs:subClassOf obo:BFO_0000141 .

obo:BFO_0000006 a owl:Class ;
    rdfs:label "spatial region"@en ;
    rdfs:comment "A continuant that consists of all or some part of space." ;
    rdfs:subClassOf obo:BFO_0000141 .

# ---------------------------------------------------------------------------
# Specifically dependent continuant subclasses
# ---------------------------------------------------------------------------

obo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:comment "A specifically dependent continuant that, in contrast to roles and dispositions, does not require any further realization in order to be exhibited. Examples: a temperature, a color, a shape." ;
    rdfs:subClassOf obo:BFO_0000020 .

obo:BFO_0000017 a owl:Class ;
    rdfs:label "realizable entity"@en ;
    rdfs:comment "A specifically dependent continuant that is exhibited through processes of a special sort that involve its bearer." ;
    rdfs:subClassOf obo:BFO_0000020 ;
    owl:disjointWith obo:BFO_0000019 .

obo:BFO_0000023 a owl:Class ;
    rdfs:label "role"@en ;
    rdfs:comment "A realizable entity whose realization is a process triggered by external circumstances rather than by the bearer's intrinsic nature (e.g., the role of judge, the role of student)." ;
    rdfs:subClassOf obo:BFO_0000017 .

obo:BFO_0000016 a owl:Class ;
    rdfs:label "disposition"@en ;
    rdfs:comment "A realizable entity whose realization is grounded in some specific feature of its bearer (e.g., the disposition of glass to break, the disposition to act virtuously)." ;
    rdfs:subClassOf obo:BFO_0000017 .

obo:BFO_0000034 a owl:Class ;
    rdfs:label "function"@en ;
    rdfs:comment "A disposition that exists in virtue of the bearer's physical makeup and is held to a normative standard given the bearer's kind (e.g., the function of the heart to pump blood)." ;
    rdfs:subClassOf obo:BFO_0000016 .

# Roles and dispositions are disjoint
obo:BFO_0000023 owl:disjointWith obo:BFO_0000016 .

# ---------------------------------------------------------------------------
# Occurrent subclasses
# ---------------------------------------------------------------------------

obo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:comment "An occurrent that is the realization of one or more dispositions, or that is performed by one or more participants. Examples: a heartbeat, a lecture, a war." ;
    rdfs:subClassOf obo:BFO_0000003 .

obo:BFO_0000035 a owl:Class ;
    rdfs:label "process boundary"@en ;
    rdfs:comment "A temporal part of a process that is a beginning or ending of the process." ;
    rdfs:subClassOf obo:BFO_0000003 ;
    owl:disjointWith obo:BFO_0000015 .

obo:BFO_0000182 a owl:Class ;
    rdfs:label "history"@en ;
    rdfs:comment "A process that is the sum of all processes taking place in the spatiotemporal region of a particular material entity." ;
    rdfs:subClassOf obo:BFO_0000015 .

# ---------------------------------------------------------------------------
# Temporal regions
# ---------------------------------------------------------------------------

obo:BFO_0000008 a owl:Class ;
    rdfs:label "temporal region"@en ;
    rdfs:comment "An occurrent that is a temporal interval or instant. Time itself, considered as having parts." ;
    rdfs:subClassOf obo:BFO_0000003 ;
    owl:disjointWith obo:BFO_0000015 .

obo:BFO_0000148 a owl:Class ;
    rdfs:label "zero-dimensional temporal region"@en ;
    rdfs:comment "A temporal region with no extent (an instant)." ;
    rdfs:subClassOf obo:BFO_0000008 .

obo:BFO_0000038 a owl:Class ;
    rdfs:label "one-dimensional temporal region"@en ;
    rdfs:comment "A temporal region with extent (an interval)." ;
    rdfs:subClassOf obo:BFO_0000008 ;
    owl:disjointWith obo:BFO_0000148 .

# ---------------------------------------------------------------------------
# Spatiotemporal region
# ---------------------------------------------------------------------------

obo:BFO_0000011 a owl:Class ;
    rdfs:label "spatiotemporal region"@en ;
    rdfs:comment "An occurrent entity that is part of spacetime." ;
    rdfs:subClassOf obo:BFO_0000003 ;
    owl:disjointWith obo:BFO_0000015 ;
    owl:disjointWith obo:BFO_0000008 .
