@prefix : <http://davidkoepsell.com/bfo-agent/seed#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Minimal SOoL-aligned seed.
# Deliberately sparse. Dialogue should reveal where this is wrong or incomplete.

:Person a owl:Class ;
    rdfs:subClassOf obo:BFO_0000040 ;
    rdfs:label "Person" .

:LegalRole a owl:Class ;
    rdfs:subClassOf obo:BFO_0000023 ;
    rdfs:label "Legal Role" .

:LegalStatus a owl:Class ;
    rdfs:subClassOf obo:BFO_0000023 ;
    rdfs:label "Legal Status" .

:LegalDocument a owl:Class ;
    rdfs:subClassOf obo:BFO_0000031 ;
    rdfs:label "Legal Document" .

:Jurisdiction a owl:Class ;
    rdfs:subClassOf obo:BFO_0000029 ;
    rdfs:label "Jurisdiction" .

:LegalProcess a owl:Class ;
    rdfs:subClassOf obo:BFO_0000015 ;
    rdfs:label "Legal Process" .
