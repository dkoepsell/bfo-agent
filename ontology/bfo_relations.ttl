# Standard BFO 2020 and RO object property declarations.
#
# Purpose: give the reasoner something to work with. The proposer emits
# triples using these predicates but never declares the predicates
# themselves, so HermiT sees them as opaque. Loading this seed alongside
# the working ontology tells the reasoner that, e.g., part-of is
# transitive, bearer-of is the inverse of inheres-in, etc.
#
# Source: BFO 2020 specification plus OBO Relation Ontology (RO).
# These declarations are domain-independent; they apply to any
# BFO-aligned ontology.

@prefix : <http://davidkoepsell.com/bfo-agent/relations#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

#
# ========== MEREOLOGY ==========
#

obo:BFO_0000050 a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "part of" ;
    owl:inverseOf obo:BFO_0000051 ;
    rdfs:comment "A continuant part of its whole, or an occurrent part of its whole. Transitive." .

obo:BFO_0000051 a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "has part" ;
    owl:inverseOf obo:BFO_0000050 .

#
# ========== INHERENCE (SDC -> BEARER) ==========
#

obo:RO_0000052 a owl:ObjectProperty ;
    rdfs:label "inheres in" ;
    owl:inverseOf obo:RO_0000053 ;
    rdfs:domain obo:BFO_0000020 ;
    rdfs:range obo:BFO_0000004 ;
    rdfs:comment "Specifically dependent continuant -> its bearer." .

obo:RO_0000053 a owl:ObjectProperty ;
    rdfs:label "bearer of" ;
    owl:inverseOf obo:RO_0000052 ;
    rdfs:domain obo:BFO_0000004 ;
    rdfs:range obo:BFO_0000020 ;
    rdfs:comment "Independent continuant -> the SDC it bears." .

#
# ========== REALIZATION (REALIZABLE <-> PROCESS) ==========
#

obo:BFO_0000054 a owl:ObjectProperty ;
    rdfs:label "realized in" ;
    owl:inverseOf obo:BFO_0000055 ;
    rdfs:domain obo:BFO_0000017 ;
    rdfs:range obo:BFO_0000015 ;
    rdfs:comment "Realizable entity (role, disposition, function) -> the process that realizes it." .

obo:BFO_0000055 a owl:ObjectProperty ;
    rdfs:label "realizes" ;
    owl:inverseOf obo:BFO_0000054 ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range obo:BFO_0000017 .

#
# ========== PARTICIPATION (CONTINUANT <-> PROCESS) ==========
#

obo:RO_0000056 a owl:ObjectProperty ;
    rdfs:label "participates in" ;
    owl:inverseOf obo:RO_0000057 ;
    rdfs:domain obo:BFO_0000004 ;
    rdfs:range obo:BFO_0000015 .

obo:RO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant" ;
    owl:inverseOf obo:RO_0000056 ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range obo:BFO_0000004 .

#
# ========== CONCRETIZATION (GDC <-> SDC/BEARER) ==========
#
# Generically dependent continuants (e.g. the text of a statute) are
# concretized in specifically dependent continuants (e.g. the specific
# inked pattern on one piece of paper) which inhere in independent
# continuants (e.g. the paper itself).

obo:RO_0000058 a owl:ObjectProperty ;
    rdfs:label "is concretized as" ;
    owl:inverseOf obo:RO_0000059 ;
    rdfs:domain obo:BFO_0000031 ;
    rdfs:range obo:BFO_0000020 .

obo:RO_0000059 a owl:ObjectProperty ;
    rdfs:label "concretizes" ;
    owl:inverseOf obo:RO_0000058 ;
    rdfs:domain obo:BFO_0000020 ;
    rdfs:range obo:BFO_0000031 .

#
# ========== TEMPORAL / OCCURRENT ==========
#

obo:BFO_0000062 a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "preceded by" ;
    owl:inverseOf obo:BFO_0000063 ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000003 .

obo:BFO_0000063 a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "precedes" ;
    owl:inverseOf obo:BFO_0000062 ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000003 .

#
# ========== SPATIAL LOCATION ==========
#

obo:RO_0001025 a owl:ObjectProperty ;
    rdfs:label "located in" ;
    rdfs:comment "A continuant is located in a site or region." .

obo:RO_0001015 a owl:ObjectProperty ;
    rdfs:label "location of" ;
    owl:inverseOf obo:RO_0001025 .

#
# ========== AGENCY / ACTION ==========
#

obo:RO_0000087 a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:domain obo:BFO_0000004 ;
    rdfs:range obo:BFO_0000023 .

obo:BFO_0000196 a owl:ObjectProperty ;
    rdfs:label "has disposition" ;
    rdfs:domain obo:BFO_0000004 ;
    rdfs:range obo:BFO_0000016 .

#
# ========== DISJOINTNESS (the reasoner's teeth) ==========
#
# These are the axioms that let HermiT actually detect contradictions.
# Without them, most ontologies pass every consistency check because
# the reasoner has no reason to think anything conflicts.

# Continuants and occurrents are disjoint.
obo:BFO_0000002 owl:disjointWith obo:BFO_0000003 .

# Independent continuants, specifically dependent continuants, and
# generically dependent continuants are mutually disjoint.
obo:BFO_0000004 owl:disjointWith obo:BFO_0000020 .
obo:BFO_0000004 owl:disjointWith obo:BFO_0000031 .
obo:BFO_0000020 owl:disjointWith obo:BFO_0000031 .

# Material entities and immaterial entities are disjoint.
obo:BFO_0000040 owl:disjointWith obo:BFO_0000141 .

# Qualities and realizable entities are disjoint specifically dependent continuants.
obo:BFO_0000019 owl:disjointWith obo:BFO_0000017 .

# Roles, dispositions, and functions are mutually disjoint realizable entities.
obo:BFO_0000023 owl:disjointWith obo:BFO_0000016 .
obo:BFO_0000023 owl:disjointWith obo:BFO_0000034 .
obo:BFO_0000016 owl:disjointWith obo:BFO_0000034 .
