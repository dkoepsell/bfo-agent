    <!-- https://w3id.org/lof/ODP004_0001100 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP004_0001100">
        <owl:inverseOf rdf:resource="https://w3id.org/lof/ODP004_0001101"/>
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <obo:IAO_0000115 xml:lang="en">A relation between a legal position and an occurrent through which the position comes into existence.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Links MLC node 7 (legal effect) to node 5 (legal act). Its range is occurrent rather than legal act so that positions arising by operation of law can be represented.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">generated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP004_0001101 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP004_0001101">
        <obo:IAO_0000115 xml:lang="en">A relation between an occurrent and a legal position that comes into existence through it.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">generates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP004_0001102 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP004_0001102">
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <obo:IAO_0000115 xml:lang="en">A relation between a legal position and an occurrent that satisfies a condition, set out in the legal content in which the position is grounded, for the position to come into existence.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">triggered by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP004_0001103 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP004_0001103">
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/lof/ODP003_0001102"/>
            <rdf:Description rdf:about="https://w3id.org/lof/ODP003_0001100"/>
        </owl:propertyChainAxiom>
        <obo:IAO_0000115 xml:lang="en">A relation between a legal position and an entity toward which the position is oriented, either the holder of its correlative position or a thing over which the position obtains.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Occupies MLC node 6 (target). Inferred for party targets by the chain: correlative of o held by. Asserted directly for thing targets (the land, the patented invention, the data set).</obo:IAO_0000116>
        <rdfs:label xml:lang="en">directed at</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP004_0001104 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP004_0001104">
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <obo:IAO_0000115 xml:lang="en">A relation between a legal position and another legal position, whose non-discharge is the occasion of the first and whose discharge or exercise is directed to making good that non-discharge.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">remedies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP004_0001105 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP004_0001105">
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
        <obo:IAO_0000115 xml:lang="en">A relation between a legal position and legal content that specifies which remedial positions arise if the position is not discharged.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">remedy provided by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP004_0001106 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP004_0001106">
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001009"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
        <obo:IAO_0000115 xml:lang="en">A relation between a first-order legal position and a temporal region during which no process occurs that complies with the position.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Represents omission without reifying non-events: the omission is the asserted non-discharge of a position over a temporal region, and the end of that region is typically the triggering occurrence of a remedial position. Proposal for review.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">undischarged during</rdfs:label>
    </owl:ObjectProperty>
    


