<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/lof/odp-002/lof-odp-002-base.owl#"
     xml:base="https://w3id.org/lof/odp-002/lof-odp-002-base.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:odp1="https://w3id.org/lof/ODP001_"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/lof/odp-002/lof-odp-002-base.owl">
        <owl:versionIRI rdf:resource="https://w3id.org/lof/odp-002/releases/0.1.0/lof-odp-002-base.owl"/>
        <dcterms:creator>David R. Koepsell</dcterms:creator>
        <dcterms:description xml:lang="en">Ontology design pattern for legal roles (judge, trustee, tenant, guardian) and the legal acts that confer and terminate them. Builds on LOF-ODP-001. DRAFT for review by the LOF founding coordinators.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title xml:lang="en">LOF-ODP-002: Legal Role Conferral</dcterms:title>
        <owl:versionInfo>0.1.0</owl:versionInfo>
    </owl:Ontology>
    


