  <rdf:Description rdf:about="http://davidkoepsell.com/sool/profiles/legal-hohfeld">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment>Profile legal-hohfeld (SPEC-bfo-agent-quality QS-E1). Constraints over canonical SOoL classes; extracted classes are bound by label alignment. Faithful mode: violations are ledger findings only.</rdfs:comment>
  </rdf:Description>
